{
  "name": "Expendora - Forgot Password",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "password-reset",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "expendora-password-reset"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "field-email",
              "name": "email",
              "value": "={{ $json.body.email || $json.email }}",
              "type": "string"
            },
            {
              "id": "field-token",
              "name": "reset_token",
              "value": "={{ $json.body.reset_token || $json.reset_token }}",
              "type": "string"
            },
            {
              "id": "field-expires",
              "name": "expires_at",
              "value": "={{ $json.body.expires_at || $json.expires_at }}",
              "type": "string"
            },
            {
              "id": "field-name",
              "name": "user_name",
              "value": "={{ $json.body.user_name || $json.user_name || 'there' }}",
              "type": "string"
            },
            {
              "id": "field-link",
              "name": "reset_link",
              "value": "=expendora://reset-password?token={{ $json.body.reset_token || $json.reset_token }}",
              "type": "string"
            },
            {
              "id": "field-subject",
              "name": "email_subject",
              "value": "Reset your Expendora password",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Prepare Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [480, 300]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=You are writing a password reset email for Expendora, a personal expense tracking app.\n\nUser name: {{ $json.user_name }}\nReset link: {{ $json.reset_link }}\nLink expires at: {{ $json.expires_at }}\n\nWrite a short, friendly plain-text email (3-5 sentences):\n- Greet the user by name\n- Explain they requested a password reset\n- Include the reset link on its own line\n- Mention the link expires in 1 hour\n- Say to ignore the email if they didn't request it\n- Sign off as \"The Expendora Team\"\n\nOutput ONLY the email body text, no subject line.",
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [720, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.1,
      "position": [720, 520]
    },
    {
      "parameters": {
        "fromEmail": "expendora@example.com",
        "toEmail": "={{ $('Prepare Data').item.json.email }}",
        "subject": "={{ $('Prepare Data').item.json.email_subject }}",
        "emailFormat": "text",
        "text": "={{ $json.output }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [960, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "collection": "email_logs",
        "fields": "type,email,sent_at,status",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Log Email Sent",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.1,
      "position": [1200, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Password reset email sent\",\n  \"email\": \"{{ $('Prepare Data').item.json.email }}\",\n  \"sent_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1440, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Prepare Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Data": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Log Email Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Email Sent": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "expendora"
    },
    {
      "name": "auth"
    }
  ],
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
