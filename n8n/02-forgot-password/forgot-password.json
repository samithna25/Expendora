{
  "name": "Expendora - Forgot Password",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "password-reset",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "expendora-password-reset"
    },
    {
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            {
              "id": "field-email",
              "name": "email",
              "value": "={{ $json.body.email || $json.email }}",
              "type": "string"
            },
            {
              "id": "field-token",
              "name": "reset_token",
              "value": "={{ $json.body.reset_token || $json.reset_token }}",
              "type": "string"
            },
            {
              "id": "field-expires",
              "name": "expires_at",
              "value": "={{ $json.body.expires_at || $json.expires_at }}",
              "type": "string"
            },
            {
              "id": "field-name",
              "name": "user_name",
              "value": "={{ $json.body.user_name || $json.user_name || 'there' }}",
              "type": "string"
            },
            {
              "id": "field-link",
              "name": "reset_link",
              "value": "={{ $json.body?.reset_redirect_url || $json.reset_redirect_url || $json.body?.reset_link || $json.reset_link || ('expendora://reset-password?token=' + ($json.body?.reset_token || $json.reset_token || '')) }}",
              "type": "string"
            },
            {
              "id": "field-subject",
              "name": "email_subject",
              "value": "Reset your Expendora password",
              "type": "string"
            },
            {
              "id": "field-reset-redirect-url",
              "name": "reset_redirect_url",
              "value": "={{ $json.body?.reset_redirect_url || $json.reset_redirect_url || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Prepare Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.item.json;\nconst escapeHtml = (value = '') => String(value).replace(/[&<>\"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[char]));\nconst userName = escapeHtml(item.user_name || 'there');\nconst email = item.email;\nconst emailSubject = item.email_subject || 'Reset your Expendora password';\nconst resetUrl = item.reset_link || item.reset_redirect_url || '';\nconst safeResetUrl = escapeHtml(resetUrl);\n\nconst html = `<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <title>Reset your Expendora password</title>\n</head>\n<body style=\"margin:0;padding:0;background-color:#111111;font-family:Arial,Helvetica,sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#111111;padding:40px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table role=\"presentation\" width=\"560\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:560px;width:100%;\">\n          <tr>\n            <td align=\"center\" style=\"padding-bottom:28px;\">\n              <p style=\"margin:0;font-size:24px;font-weight:800;letter-spacing:4px;color:#FACC15;\">&#10022; EXPENDORA</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"background-color:#1A1A1A;border-radius:16px;border:1px solid #2E2510;padding:40px 36px;\">\n              <p style=\"margin:0 0 8px 0;font-size:20px;font-weight:700;color:#FFFFFF;\">Hi ${userName},</p>\n              <p style=\"margin:0 0 32px 0;font-size:15px;color:#AAAAAA;line-height:1.7;\">We received a request to reset your Expendora password. Click the button below to set a new password for your account.</p>\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"margin:0 auto 24px auto;\">\n                <tr>\n                  <td align=\"center\" bgcolor=\"#FACC15\" style=\"border-radius:10px;background-color:#FACC15;\">\n                    <a href=\"${safeResetUrl}\" target=\"_blank\" rel=\"noopener\" style=\"display:block;padding:16px 48px;border-radius:10px;background-color:#FACC15;color:#0A0A0A;font-size:15px;font-weight:700;line-height:18px;text-align:center;text-decoration:none;\">Reset My Password</a>\n                  </td>\n                </tr>\n              </table>\n              <p style=\"margin:0 0 28px 0;font-size:13px;color:#777777;text-align:center;\">This link expires in <strong style=\"color:#FACC15;\">1 hour</strong>.</p>\n              <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\" style=\"margin-bottom:24px;\"><tr><td style=\"border-top:1px solid #2A2A2A;font-size:0;line-height:0;\">&nbsp;</td></tr></table>\n              <p style=\"margin:0;font-size:13px;color:#666666;line-height:1.6;\">If you didn't request a password reset, you can safely ignore this email. Your password will remain unchanged.</p>\n            </td>\n          </tr>\n          <tr>\n            <td align=\"center\" style=\"padding-top:28px;\">\n              <p style=\"margin:0;font-size:12px;color:#444444;\">&copy; 2026 Expendora. All rights reserved.</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>`;\n\nreturn {\n  email,\n  email_subject: emailSubject,\n  email_html: html,\n};"
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Build Email HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "expendora@example.com",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.email_subject }}",
        "emailFormat": "html",
        "html": "={{ $json.email_html }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "collection": "email_logs",
        "fields": "type,email,sent_at,status",
        "options": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Log Email Sent",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1.1,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"message\": \"Password reset email sent\",\n  \"email\": \"{{ $('Prepare Data').item.json.email }}\",\n  \"sent_at\": \"{{ $now.toISO() }}\"\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1440,
        300
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Prepare Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Data": {
      "main": [
        [
          {
            "node": "Build Email HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Email HTML": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Log Email Sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Email Sent": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "expendora"
    },
    {
      "name": "auth"
    }
  ],
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
